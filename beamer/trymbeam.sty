% CUSTOM BLOCK ENVIRONMENTS


% Custom alert block using colors from trymtex.sty
\newenvironment{importantblock}[1]{%
    \setbeamercolor{block title}{fg=surface, bg=def-color}%
    \setbeamercolor{block body}{fg=text, bg=def-color!10}%
    \begin{block}{#1}%
}{%
    \end{block}%
}

% Custom example block
\newenvironment{tipblock}[1]{%
    \setbeamercolor{block title}{fg=surface, bg=rem-color}%
    \setbeamercolor{block body}{fg=text, bg=rem-color!10}%
    \begin{block}{#1}%
}{%
    \end{block}%
}


\endinput
